#include <iostream>
using namespace std;

char b[3][3] = {{'1','2','3'},
                {'4','5','6'},
                {'7','8','9'}};

void show() {
    for(int i=0;i<3;i++)
        cout << b[i][0] << " | " << b[i][1] << " | " << b[i][2] << "\n";
}

bool win(char p) {
    for(int i=0;i<3;i++)
        if(b[i][0]==p && b[i][1]==p && b[i][2]==p) return true;

    for(int i=0;i<3;i++)
        if(b[0][i]==p && b[1][i]==p && b[2][i]==p) return true;

    return (b[0][0]==p && b[1][1]==p && b[2][2]==p) ||
           (b[0][2]==p && b[1][1]==p && b[2][0]==p);
}

bool full() {
    for(int i=0;i<3;i++)
        for(int j=0;j<3;j++)
            if(b[i][j]!='X' && b[i][j]!='O') return false;
    return true;
}

int main() {
    int pos;

    for(int turn=0; turn<9; turn++) {
        show();

        char p = (turn%2==0) ? 'X' : 'O';
        cout << "Player " << p << ", enter position: ";
        cin >> pos;

        int r=(pos-1)/3, c=(pos-1)%3;

        if(b[r][c]=='X' || b[r][c]=='O') {
            cout << "Invalid move!\n";
            turn--;
            continue;
        }

        b[r][c]=p;

        if(win(p)) {
            show();
            cout << p << " wins!\n";
            return 0;
        }

        if(full()) {
            show();
            cout << "Draw!\n";
            return 0;
        }
    }
}

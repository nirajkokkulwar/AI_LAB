# MAIN PROGRAM
# ==========================================

print("========================================")
print("          8 - PUZZLE SOLVER")
print("          A* SEARCH ALGORITHM")
print("========================================")

print("\nEnter initial puzzle")
print("(Use 0 for blank space)")

start = tuple(map(int, input("> ").split()))

limit = int(input("\nEnter maximum depth/level limit: "))

print("\n========================================")
print("             SEARCH STARTED")
print("========================================")

print("Initial State:")
show(start, 0, 0)

solve(start, limit)
